{
  "compilerOptions": {
    "lib": ["ESNext"],
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "experimentalDecorators":true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports":true,




    "noUnusedParameters": false,
    "removeComments": true,
    "sourceMap": true,    
    "declaration": true,
    "target": "ES2020", 
    "module": "CommonJS",
  }
}
